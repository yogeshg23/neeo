rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{boardId} {
      allow read: if canRead(resource.data);
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if canEdit(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /boards/{boardId}/columns/{columnId} {
      allow read: if canReadBoard(boardId);
      allow create: if canEditBoard(boardId)
        && request.resource.data.boardId == boardId;
      allow update: if canEditBoard(boardId)
        && request.resource.data.boardId == boardId;
      allow delete: if canEditBoard(boardId);
    }

    match /boards/{boardId}/columns/{columnId}/tasks/{taskId} {
      allow read: if canReadBoard(boardId);
      allow create: if canEditBoard(boardId)
        && request.resource.data.boardId == boardId
        && request.resource.data.columnId == columnId;
      allow update: if canEditBoard(boardId)
        && request.resource.data.boardId == boardId
        && request.resource.data.columnId == columnId;
      allow delete: if canEditBoard(boardId);
    }

    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId)
        && request.resource.data.id == userId
        && request.resource.data.role == 'user';
      allow update: if isUser(userId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.role == resource.data.role;
      allow delete: if isUser(userId);
    }

    function canRead(board) {
      return isOwner(board.ownerId)
        || hasRole(board, 'owner')
        || hasRole(board, 'editor')
        || hasRole(board, 'viewer');
    }

    function canEdit(board) {
      return isOwner(board.ownerId)
        || hasRole(board, 'owner')
        || hasRole(board, 'editor');
    }

    function canReadBoard(boardId) {
      return canRead(get(/databases/$(database)/documents/boards/$(boardId)).data);
    }

    function canEditBoard(boardId) {
      return canEdit(get(/databases/$(database)/documents/boards/$(boardId)).data);
    }

    function hasRole(board, role) {
      return request.auth != null
        && board.members[request.auth.uid] == role;
    }

    function isOwner(ownerId) {
      return request.auth != null && request.auth.uid == ownerId;
    }

    function isUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
  }
}
